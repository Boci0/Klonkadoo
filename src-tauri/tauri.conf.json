{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slingshot Ops",
  "version": "../package.json",
  "identifier": "com.slingshotops.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "npm run dev -- --mode app",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "KLONKADOO",
        "width": 1280,
        "height": 750,
        "minWidth": 800,
        "minHeight": 470,
        "center": true,
        "backgroundColor": "#10111c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyQ0M0MzEwQTUyRjkwQUMKUldTc2tDK2xFRVBNd3YwTUVNbWUyRzBSakN5bTZER2xsRWc4Q0VQSnNac2ExWHFDRlRwY2U1ZGcK",
      "endpoints": ["https://github.com/Boci0/Slingshot-OPS/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
